<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Microsoft.Deployment.WindowsInstaller</AssemblyName>
    <RootNamespace>Microsoft.Deployment.WindowsInstaller</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);SYSLIB0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../DTF/Libraries/WindowsInstaller/*.cs" Exclude="../../DTF/Libraries/WindowsInstaller/AssemblyInfo.cs" />
    <EmbeddedResource Include="../../DTF/Libraries/WindowsInstaller/Errors.resources">
      <LogicalName>Microsoft.Deployment.WindowsInstaller.Errors.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>
</Project>
