<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>lit</AssemblyName>
    <RootNamespace>Microsoft.Tools.WindowsInstallerXml.Tools</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0618;SYSLIB0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../tools/lit/*.cs" Exclude="../../tools/lit/AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../tools/lit/LitStrings.resx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Wix.Legacy.Console/Wix.Legacy.Console.csproj" />
    <ProjectReference Include="../Wix.Legacy.Core/Wix.Legacy.Core.csproj" />
  </ItemGroup>
</Project>
